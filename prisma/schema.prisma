// Prisma schema for newhome
// Uses dedicated `newhome` schema in the shared Postgres database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["newhome"]
}

model Announcement {
  id          String   @id
  source      String
  noticeNo    String   @map("notice_no")
  title       String
  housingType String   @map("housing_type")
  region      String
  city        String?
  postedAt    String   @map("posted_at")
  applyStart  String?  @map("apply_start")
  applyEnd    String?  @map("apply_end")
  status      String?
  detailUrl   String   @map("detail_url")
  isPriority  Boolean  @default(false) @map("is_priority")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  notifiedAt  DateTime? @map("notified_at")
  // chatIds the announcement has already been pushed to (per-channel dedup).
  notifiedChannels String[] @default([]) @map("notified_channels")
  raw         Json?

  @@index([source, postedAt])
  @@index([isPriority])
  @@map("announcements")
  @@schema("newhome")
}

model Filter {
  id              Int      @id @default(1)
  housingTypes    String[] @map("housing_types")
  regions         String[]
  priorityCities  String[] @map("priority_cities")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("filter")
  @@schema("newhome")
}

// 사용자가 "일정 추가"를 누른 공고. 구독 ICS 피드(/api/calendar.ics)에 담긴다.
// 이 앱은 인증이 없어 단일 사용자 전역 목록이다(Filter id=1 과 같은 성격).
model CalendarPick {
  announcementId String   @id @map("announcement_id")
  addedAt        DateTime @default(now()) @map("added_at")
  // LH가 접수기간을 공개하지 않은 공고(첨부 공고문에만 있음)를 위해
  // 사용자가 직접 넣은 신청일. 있으면 공고의 applyStart/applyEnd 보다 우선한다.
  manualStart    String?  @map("manual_start")
  manualEnd      String?  @map("manual_end")

  @@map("calendar_picks")
  @@schema("newhome")
}

model SeenAnnouncement {
  announcementId String   @id @map("announcement_id")
  seenAt         DateTime @default(now()) @map("seen_at")

  @@map("seen_announcements")
  @@schema("newhome")
}
